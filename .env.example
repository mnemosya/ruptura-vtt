# Ruptura VTT — variáveis de ambiente (checkpoint pós-v0.94, fase 13).
# Só nomes/comentários aqui — NUNCA valores reais. Copie para .env.local
# e preencha com as credenciais do seu próprio projeto Supabase.

# URL do projeto Supabase (painel do projeto → Project Settings → API).
SUPABASE_URL=

# Chave anon pública do Supabase — segura para expor no client.
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — NUNCA usar no client, só em scripts locais confiáveis
# (seed/migração). Nunca commitar o valor real.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string direta ao Postgres (scripts de migração locais).
SUPABASE_DB_URL=

# Diretório dos arquivos de conteúdo canônico (scripts/seed-content.ts).
CONTENT_DIR=
